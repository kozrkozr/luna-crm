{
  "name": "luna-crm",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@supabase/supabase-js": "^2.58.0",
    "@tamagui/animations-react-native": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.115.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
