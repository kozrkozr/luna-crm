{
  "name": "luna-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "serve:link": "node scripts/serve-link-surface.js",
    "test:acceptance": "bash tests/acceptance/run-all.sh",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "ws": "^7.5.13"
  },
  "overrides": {
