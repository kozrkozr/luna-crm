{
  "name": "luna-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/variant.mjs dev expo start --dev-client",
    "start:local": "node scripts/variant.mjs local expo start --dev-client",
    "ios": "node scripts/variant.mjs dev --prebuild expo run:ios --device",
    "ios:local": "node scripts/variant.mjs local --prebuild expo run:ios",
    "ios:prod": "node scripts/variant.mjs prod --prebuild expo run:ios --device --configuration Release",
    "prebuild:prod": "node scripts/variant.mjs prod --clean",
    "web": "expo start --web",
    "export:web": "expo export -p web --clear && node scripts/prepare-link-surface.js",
    "use:dev": "node scripts/env.mjs use dev",
    "use:prod": "node scripts/env.mjs use prod",
    "env:status": "node scripts/env.mjs status",
    "env:verify": "node scripts/env.mjs verify",
    "deploy:web": "node scripts/variant.mjs prod sh -c 'npm run export:web && node scripts/env.mjs verify && npx wrangler pages deploy dist --project-name=luna-crm --branch=main'",
    "deploy:web:dev": "node scripts/variant.mjs dev sh -c 'npm run export:web && node scripts/env.mjs verify && npx wrangler pages deploy dist --project-name=luna-crm --branch=dev'",
    "serve:link": "node scripts/serve-link-surface.js",
    "theme:freeze": "node scripts/theme-playground/freeze.mjs",
    "theme:seed": "node scripts/theme-playground/seed.mjs",
    "theme": "node scripts/theme-playground/serve.mjs",
    "test:acceptance": "bash tests/acceptance/run-all.sh",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "smoke:deployed": "node scripts/smoke-deployed.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "ws": "^7.5.13"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
