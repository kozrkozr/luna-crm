# EP-07 — the storage settings for functions served locally against the local S3
# (`bash scripts/local-s3.sh start`). Fake, local-only credentials: safe to commit.
#
#   npx supabase functions serve --env-file supabase/functions/local-s3.env
#
# The functions run in Docker and reach the store at host.docker.internal; a
# browser or a suite reaches it at 127.0.0.1, so presigned URLs are signed for
# that host (`B2_PUBLIC_ENDPOINT`, storage.ts).
B2_ENDPOINT=http://host.docker.internal:8333
B2_PUBLIC_ENDPOINT=http://127.0.0.1:8333
B2_REGION=us-east-1
B2_BUCKET=luna-files-local
B2_KEY_ID=luna-local-key
B2_APPLICATION_KEY=luna-local-secret
# US-037 — the sweeper's shared secret, local only.
FILES_SWEEPER_SECRET=local-sweeper-secret
