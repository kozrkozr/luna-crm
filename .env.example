# Copy to .env.dev and .env.prod, then switch between them:
#   npm run use:dev   /   npm run use:prod   /   npm run env:status
#
# These are inlined at BUILD time, not read at runtime. Changing them changes
# nothing until both surfaces are rebuilt — `npm run export:web` for the link
# views and `npm run ios` for the app.
#
# The anon / publishable key is public by design: every table is closed to it
# (see supabase/migrations/20260825140000_grants.sql) and RLS decides the rest.
# The service_role key must NEVER appear here — EXPO_PUBLIC_ means "shipped
# inside the bundle". It belongs only to the link gateway, which receives it
# from Supabase automatically.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# The host serving the static export — where /s/<token> links point.
# Production is the custom domain; dev is the Pages branch alias.
EXPO_PUBLIC_LINK_BASE_URL=https://lunashoots.com

# RevenueCat public SDK key (ADR-023) — dev: Test Store `test_…`, prod: App Store `appl_…`.
# Public by design; the secret key lives only in the revenuecat-webhook function.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=<test_… or appl_…>
