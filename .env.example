# Copy to .env and fill from your Supabase project settings.
# EXPO_PUBLIC_ prefixed vars are embedded in the client bundle — the anon key is
# safe there (RLS is what protects data); never put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where a shared crew/client link points (US-006). This is the Cloudflare Pages
# host that serves the static export (ADR-012) — the link surface, not the app.
# It has no default: a link built against the wrong origin is one a crew member
# cannot open, and silently guessing localhost would ship that.
EXPO_PUBLIC_LINK_BASE_URL=
